recommend_trajectory(simulated_user)
'⚠️ With this profile, your probability of exceeding 50K is only 2.0%. Consider improving your education or changing your occupation.'

def compare_trajectories(user_profile):
    scenarios = []

    changes = [
        {"education": "Bachelors"},
        {"education": "Masters"},
        {"occupation": "Exec-managerial"},
        {"occupation": "Prof-specialty"},
        {"hours.per.week": 40},
        {"hours.per.week": 50},
    ]

    base_df = pd.DataFrame([user_profile])
    base_prob = model.predict_proba(base_df)[0][1]

    scenarios.append(("Current profile", base_prob))

    for change in changes:
        new_profile = user_profile.copy()
        new_profile.update(change)

        new_df = pd.DataFrame([new_profile])
        prob = model.predict_proba(new_df)[0][1]

        label = ", ".join([f"{k} = {v}" for k, v in change.items()])
        scenarios.append((label, prob))

    results = pd.DataFrame(scenarios, columns=["Scenario", "Probability >50K"])
    results["Probability >50K"] = results["Probability >50K"] * 100
    return results.sort_values(by="Probability >50K", ascending=False)
                           
compare_trajectories(simulated_user)
